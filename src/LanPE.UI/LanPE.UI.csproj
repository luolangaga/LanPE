<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LanPE.UI</RootNamespace>
    <AssemblyName>LanPE.Packer</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- MewUI：只保留 Direct2D 后端，减小 AOT 体积 -->
    <MewUIBackend>Direct2D</MewUIBackend>
    <!-- DevTools 依赖反射，AOT 下不可用（设为 false 并裁剪掉） -->
    <MewUIDevTools>false</MewUIDevTools>
    <MewUIHotReload>false</MewUIHotReload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Windows" Version="0.22.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanPE.Core\LanPE.Core.csproj" />
    <ProjectReference Include="..\LanPE.Build\LanPE.Build.csproj" />
    <ProjectReference Include="..\LanPE.Disk\LanPE.Disk.csproj" />
  </ItemGroup>

</Project>
